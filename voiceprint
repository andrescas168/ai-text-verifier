#!/usr/bin/env bash
# voiceprint - does this text read as machine-written?
#   detect  stylometric signals, stdlib only, runs anywhere
#   ppl     GPT-2 perplexity + GLTR rank buckets, needs ~/venvs/ppl
#   both    run detect then ppl
set -u

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="${VP_VENV:-$HOME/venvs/ppl}/bin/python"

usage() {
  cat <<'EOF'
usage: voiceprint {detect|ppl|bino|both} FILE [FILE ...]

  detect   surface signals: burstiness, lexical richness, tricolon rate,
           opener diversity, two-tier tell lexicon. No dependencies.
  ppl      token log-probs under Qwen3-0.6B: per-sentence rewrite candidates
           first, then document perplexity and GLTR buckets. Needs the venv.
  bino     Binoculars (Hans et al. 2024): perplexity / cross-perplexity over a
           base+instruct pair. The fairness-correct method. Loads 2 models.
  both     detect, then ppl.

reads .docx .md .txt .pdf

Reference points from the shipped controls (Qwen3-0.6B):
  LLM-register control   ppl  7.5   burst 0.54   top-10 87.8%   bino 0.9751
  human control          ppl 63.0   burst 0.54   top-10 60.9%   bino 1.0205
EOF
}

cmd="${1:-}"
[ $# -gt 0 ] && shift

case "$cmd" in
  detect)
    exec python3 "$HERE/detect.py" "$@"
    ;;
  bino)
    if [ ! -x "$VENV" ]; then
      echo "voiceprint: missing venv at $VENV" >&2
      exit 1
    fi
    exec "$VENV" "$HERE/binoculars.py" "$@"
    ;;
  ppl)
    if [ ! -x "$VENV" ]; then
      echo "voiceprint: missing venv at $VENV" >&2
      echo "  python3 -m venv ~/venvs/ppl" >&2
      echo "  ~/venvs/ppl/bin/pip install -r $HERE/requirements.txt" >&2
      exit 1
    fi
    exec "$VENV" "$HERE/ppl.py" "$@"
    ;;
  both)
    python3 "$HERE/detect.py" "$@"
    if [ -x "$VENV" ]; then
      "$VENV" "$HERE/ppl.py" "$@"
    else
      echo "(skipping ppl: venv not installed)" >&2
    fi
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    echo "voiceprint: unknown command '$cmd'" >&2
    usage >&2
    exit 1
    ;;
esac
